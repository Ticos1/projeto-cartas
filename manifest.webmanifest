{
	"id": "./",
	"name": "Ticards",
	"short_name": "Ticards",
	"description": "Controle da sua coleção de cartas Pokémon TCG da série Megaevolução.",
	"lang": "pt-BR",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#14161c",
	"theme_color": "#14161c",
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
	],
	"shortcuts": [
		{ "name": "Escanear cartas", "short_name": "Escanear", "description": "Reconhecer cartas pela câmera", "url": "./#/escanear", "icons": [{ "src": "icons/atalho-escanear.png", "sizes": "96x96", "type": "image/png" }] },
		{ "name": "Pesquisar cartas", "short_name": "Pesquisa", "description": "Buscar uma carta pelo nome", "url": "./#/pesquisa", "icons": [{ "src": "icons/atalho-pesquisa.png", "sizes": "96x96", "type": "image/png" }] },
		{ "name": "Lista de desejos", "short_name": "Desejos", "description": "Cartas que você quer conseguir", "url": "./#/desejos", "icons": [{ "src": "icons/atalho-desejos.png", "sizes": "96x96", "type": "image/png" }] }
	],
	"share_target": {
		"action": "./receber",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "titulo",
			"text": "texto",
			"url": "url",
			"files": [
				{ "name": "arquivos", "accept": ["application/json", "text/plain", "application/octet-stream", ".json", ".txt"] }
			]
		}
	},
	"screenshots": [
		{ "src": "icons/telas/celular-set.jpg", "sizes": "824x1830", "type": "image/jpeg", "form_factor": "narrow", "label": "Marque as cartas que você já tem em cada coleção" },
		{ "src": "icons/telas/celular-pesquisa.jpg", "sizes": "824x1830", "type": "image/jpeg", "form_factor": "narrow", "label": "Pesquise qualquer carta pelo nome ou número" },
		{ "src": "icons/telas/celular-colecoes.jpg", "sizes": "824x1830", "type": "image/jpeg", "form_factor": "narrow", "label": "Acompanhe o progresso de todas as coleções" },
		{ "src": "icons/telas/tablet-set.jpg", "sizes": "1920x1200", "type": "image/jpeg", "form_factor": "wide", "label": "No tablet, a coleção aparece em seis colunas" },
		{ "src": "icons/telas/tablet-colecoes.jpg", "sizes": "1920x1200", "type": "image/jpeg", "form_factor": "wide", "label": "Todas as coleções e o quanto falta em cada uma" }
	]
}
